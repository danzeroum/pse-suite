{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pse-suite/finding-1.0",
  "type": "object",
  "required": ["check_id", "pack", "severidade", "titulo", "descricao", "recomendacao"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^[PSE]-[0-9]{2}$"},
    "pack": {"enum": ["privacy", "security", "ethics"]},
    "severidade": {"enum": ["CRITICO", "ALTO", "MEDIO", "BAIXO", "INFO"]},
    "titulo": {"type": "string"},
    "descricao": {"type": "string"},
    "recomendacao": {"type": "string"},
    "base_legal": {"type": ["string", "null"]},
    "arquivo": {"type": ["string", "null"]},
    "linha": {"type": ["integer", "null"]},
    "snippet": {"type": ["string", "null"]}
  }
}
