{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://danzeroum.github.io/pse-suite/schemas/finding-1.0.json",
  "type": "object",
  "required": ["check_id", "pack", "severidade", "titulo", "descricao", "recomendacao"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^[PSE]-[0-9]{2}$"},
    "pack": {"enum": ["privacy", "security", "ethics"]},
    "severidade": {"enum": ["CRITICO", "ALTO", "MEDIO", "BAIXO", "INFO"]},
    "titulo": {"type": "string", "minLength": 1},
    "descricao": {"type": "string", "minLength": 1},
    "recomendacao": {"type": "string", "minLength": 1},
    "base_legal": {"type": ["string", "null"]},
    "arquivo": {"type": ["string", "null"]},
    "linha": {"type": ["integer", "null"], "minimum": 1},
    "snippet": {
      "type": ["string", "null"],
      "description": "Sanitizado com a propria regua antes de serializar: a evidencia nao republica o dado que denuncia. O localizador do achado e arquivo:linha, nunca o literal."
    }
  }
}
